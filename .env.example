# Variables PÚBLICAS de la app Expo.
# Todas las EXPO_PUBLIC_* se incrustan en el bundle/APK al compilar (visibles para cualquiera):
# no pongas aquí secretos. Los secretos del backend (MongoDB, CLERK_SECRET_KEY...) van en server/.env.
# EAS Build sube este .env (ver .easignore) para fijar estas variables en el APK.

# Clave de API de The Movie Database (TMDB v3)
# Obtén tu clave gratuita en: https://www.themoviedb.org/settings/api
EXPO_PUBLIC_TMDB_API_KEY=

# Clave de API de RAWG Video Games Database
# Obtén tu clave gratuita en: https://rawg.io/apidocs
EXPO_PUBLIC_RAWG_API_KEY=

# Clave pública de Clerk (Authentication)
# Obtén tu clave en: https://dashboard.clerk.com/ -> API Keys -> Publishable key (pk_test_...)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Distribución de Actualizaciones y APK ---
# Opción 1: Repositorio de GitHub para verificar releases y descargar APK (ej. usuario/cultoteca)
EXPO_PUBLIC_GITHUB_REPO=

# Opción 2: URL de manifiesto JSON remoto personalizado (ej. https://tudominio.com/version.json)
# Formato esperado del JSON:
# {
#   "version": "1.0.1",
#   "apkUrl": "https://tudominio.com/cultoteca-1.0.1.apk",
#   "releaseNotes": "Corrección de errores y nuevas funcionalidades",
#   "publishedAt": "2026-10-04T00:00:00Z"
# }
EXPO_PUBLIC_UPDATE_URL=

# --- Backend (repositorio aparte: server/ -> cultoteca-api) ---
# Las variables del servidor (MongoDB, Clerk secret, proveedores) van en server/.env (ver server/.env.example)
# URL de la API del backend accesible desde la aplicación Expo / React Native
# Para desarrollo web o simulador iOS/Android: http://localhost:5001
# Para pruebas en dispositivo físico en la misma red Wi-Fi: http://192.168.1.X:5001
EXPO_PUBLIC_API_URL=http://localhost:5001
