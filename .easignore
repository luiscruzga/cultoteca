# Ficheros excluidos del upload a EAS Build.
# Si existe, EAS usa este fichero EN LUGAR de .gitignore: mantenlo sincronizado.
# Diferencias con .gitignore: se sube .env (solo contiene EXPO_PUBLIC_*, necesarias en el APK)
# y se excluyen explícitamente server/ y carpetas de planificación/herramientas.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env overrides (el .env principal SÍ se sube)
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# backend: repositorio independiente (cultoteca-api), nunca forma parte de la app
/server/

# planificación y herramientas, no necesarias para compilar
/openspec/
/.serena/
/.claude/
